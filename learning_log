CODE FOR THE EXERCISE:
const int redLED = 2;
const int greenLED = 3;
const int blueLED = 4;


void setup() {
  pinMode(redLED, OUTPUT);
  pinMode(greenLED, OUTPUT);
  pinMode(blueLED, OUTPUT);
}

void loop() {
  setRGB(255,0,0); //red color
  delay(1000);
  setRGB(0,255,0); //green color
  delay(1000);
  setRGB(0,0,255); //blue color
  delay(1000);
  setRGB(255,0,255); //purple color
  delay(1000);
  setRGB(255,255,0); //cyan color
  delay(1000);
  setRGB(0,255,255); //yellow color
  delay(1000);
}

void setRGB(int redValue, int greenValue, int blueValue){
  analogWrite(redLED, redValue);
  analogWrite(greenLED, greenValue);
  analogWrite(blueLED, blueValue);
}

(The only thing we need to do to change the color is use `setRGB` and `delay`: for the colors, we follow the numerical order (red, green, blue), and for the light intensity, we use the value 255.)
